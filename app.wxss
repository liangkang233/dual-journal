page {
  background: #f5f5f5;
  color: #111;
  font-size: 32rpx;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

/* —— 配对空间背景预设 —— */
.page-bg {
  background-attachment: fixed;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
}

.page-bg-plain {
  background-color: #f5f5f5;
  background-image: none;
}

.page-bg-warm {
  background-color: #fff4e8;
  background-image: url('/assets/bg/warm.jpg');
}

.page-bg-mint {
  background-color: #e8f7f2;
  background-image: url('/assets/bg/mint.jpg');
}

.page-bg-night {
  background-color: #1a1f2e;
  background-image: url('/assets/bg/night.jpg');
  color: #e8eaf0;
}

.page-bg-blush {
  background-color: #fde8ef;
  background-image: url('/assets/bg/blush.jpg');
}

.page-bg-night .empty-title,
.page-bg-night .section-title,
.page-bg-night .status-line,
.page-bg-night .entry-title,
.page-bg-night .todo-title,
.page-bg-night .ann-title {
  color: #f0f2f8;
}

.page-bg-night .empty-desc,
.page-bg-night .hint,
.page-bg-night .meta,
.page-bg-night .entry-content,
.page-bg-night .entry-meta {
  color: #a8b0c4;
}

.page-bg-custom {
  background-color: #f0f0f0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.empty {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}

.empty-illust {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 8rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.empty-desc {
  font-size: 28rpx;
  color: #888;
  line-height: 1.6;
  max-width: 520rpx;
}

.empty-cta {
  margin-top: 32rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  padding: 16rpx 48rpx;
  border-radius: 48rpx;
}

.empty-visible .empty-title {
  color: #111 !important;
}

.empty-visible .empty-desc {
  color: #333 !important;
}

.empty-cta {
  background: #07c160 !important;
  color: #fff !important;
  border: 2rpx solid #05964a;
  font-weight: 600;
}
