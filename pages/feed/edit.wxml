<view class="page edit-page">
  <view class="card">
    <view class="label">标题</view>
    <input
      class="title-input"
      placeholder="给这条见闻起个标题"
      maxlength="40"
      value="{{title}}"
      data-field="title"
      bindinput="onFieldInput"
    />
  </view>

  <view class="card">
    <view class="label">时间</view>
    <view class="label-row">
      <picker mode="date" value="{{timeDate}}" bindchange="onTimeDateChange">
        <view class="date-picker {{timeDate ? '' : 'placeholder'}}">{{timeDate || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{timeClock}}" bindchange="onTimeClockChange">
        <view class="date-picker {{timeClock ? '' : 'placeholder'}}">{{timeClock || '选择时间'}}</view>
      </picker>
    </view>
    <view class="hint" wx:if="{{timeAt}}">已选：{{timeAt}}</view>
  </view>

  <view class="card">
    <view class="label">地点</view>
    <input
      class="title-input"
      placeholder="在哪里"
      maxlength="80"
      value="{{location}}"
      data-field="location"
      bindinput="onFieldInput"
    />
  </view>

  <view class="card">
    <view class="label">人物</view>
    <input
      class="title-input"
      placeholder="涉及谁"
      maxlength="80"
      value="{{people}}"
      data-field="people"
      bindinput="onFieldInput"
    />
  </view>

  <view class="card">
    <view class="label">起因</view>
    <textarea
      class="content-input short"
      placeholder="为什么发生 / 起因"
      maxlength="500"
      value="{{cause}}"
      data-field="cause"
      bindinput="onFieldInput"
      auto-height
    />
  </view>

  <view class="card">
    <view class="label">经过</view>
    <textarea
      class="content-input"
      placeholder="事情是怎么经过的…"
      maxlength="2000"
      value="{{process}}"
      data-field="process"
      bindinput="onFieldInput"
      auto-height
    />
  </view>

  <view class="card">
    <view class="label">结果</view>
    <textarea
      class="content-input short"
      placeholder="最终结果 / 感受"
      maxlength="500"
      value="{{result}}"
      data-field="result"
      bindinput="onFieldInput"
      auto-height
    />
  </view>

  <view class="card" wx:if="{{!isEdit}}">
    <view class="label-row">
      <view class="label">图片</view>
      <view class="hint-inline">最多 {{maxImages}} 张</view>
    </view>
    <view class="image-grid">
      <view
        class="image-item"
        wx:for="{{tempFilePaths}}"
        wx:key="*this"
      >
        <image
          class="preview"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="onPreviewLocal"
        />
        <view class="remove" data-index="{{index}}" catchtap="onRemoveImage">×</view>
      </view>
      <view
        class="image-add"
        wx:if="{{tempFilePaths.length < maxImages}}"
        bindtap="onChooseImages"
      >
        <text class="plus">+</text>
        <text class="add-text">添加</text>
      </view>
    </view>
  </view>

  <button
    class="btn primary submit"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="onSubmit"
  >
    {{isEdit ? '保存修改' : '发布见闻'}}
  </button>
</view>
