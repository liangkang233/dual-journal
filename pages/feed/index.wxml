<view class="page feed-page {{bgClass}}" style="{{bgStyle}}">
  <view wx:if="{{!paired}}" class="empty empty-visible">
    <image class="empty-illust" src="/assets/empty/feed.jpg" mode="aspectFit" />
    <view class="empty-title">{{emptyTitle}}</view>
    <view class="empty-desc">{{emptyDesc}}</view>
    <button class="empty-cta" bindtap="goPair">去「我们」生成邀请 / 加入</button>
  </view>

  <block wx:else>
    <view
      class="today-banner"
      wx:if="{{todayBannerText}}"
      bindtap="goAnniversaries"
    >
      <view class="today-banner-icon">🎉</view>
      <view class="today-banner-text">{{todayBannerText}}</view>
      <view class="today-banner-more">查看</view>
    </view>

    <view wx:if="{{loading && !entries.length}}" class="hint-center">加载中…</view>

    <view wx:elif="{{!entries.length}}" class="empty empty-visible">
      <image class="empty-illust" src="/assets/empty/feed.jpg" mode="aspectFit" />
      <view class="empty-title">还没有见闻</view>
      <view class="empty-desc">写下时间、地点、人物、起因、经过、结果</view>
      <button class="empty-cta" bindtap="goEdit">写一条见闻</button>
    </view>

    <view wx:else class="timeline">
      <view
        class="entry-card"
        wx:for="{{entries}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="goDetail"
      >
        <view class="entry-title">{{item.title || '无标题'}}</view>
        <view class="entry-fields" wx:if="{{item.fieldLine}}">{{item.fieldLine}}</view>
        <view class="entry-content">{{item.processPreview}}</view>
        <view class="entry-result" wx:if="{{item.resultPreview}}">结果：{{item.resultPreview}}</view>
        <view class="entry-thumbs" wx:if="{{item.previewImages.length}}">
          <image
            wx:for="{{item.previewImages}}"
            wx:for-item="img"
            wx:key="*this"
            class="thumb"
            src="{{img}}"
            mode="aspectFill"
          />
        </view>
        <view class="entry-meta">{{item.timeText}}</view>
      </view>
    </view>

    <view class="fab" bindtap="goEdit">写</view>
  </block>
</view>
