<view class="page detail-page">
  <view wx:if="{{loading}}" class="hint-center">加载中…</view>

  <view wx:elif="{{errorText}}" class="empty">
    <view class="empty-title">无法查看</view>
    <view class="empty-desc">{{errorText}}</view>
    <button class="empty-cta" wx:if="{{errorText === '请先完成配对'}}" bindtap="goPair">
      去「我们」完成配对
    </button>
  </view>

  <block wx:elif="{{entry}}">
    <view class="card">
      <view class="detail-title">{{entry.title || '无标题'}}</view>
      <view class="detail-time">{{timeText}}</view>
      <view class="detail-content">{{entry.content}}</view>
    </view>

    <view class="card" wx:if="{{entry.imageFileIds.length}}">
      <view class="images">
        <image
          wx:for="{{entry.imageFileIds}}"
          wx:key="*this"
          class="full-img"
          src="{{item}}"
          mode="widthFix"
          data-src="{{item}}"
          bindtap="onPreview"
        />
      </view>
    </view>
  </block>
</view>
