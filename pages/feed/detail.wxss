.detail-page {
  padding-bottom: 80rpx;
}

.hint-center {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.4;
}

.detail-time {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.detail-content {
  margin-top: 28rpx;
  font-size: 30rpx;
  color: #444;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
}

.images {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.full-img {
  width: 100%;
  border-radius: 16rpx;
  background: #eee;
}
