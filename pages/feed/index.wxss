.feed-page {
  padding-bottom: 160rpx;
  position: relative;
}

.hint-center {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.today-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #fff5e6, #ffe8f0);
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #ffd4a8;
}

.today-banner-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.today-banner-text {
  flex: 1;
  font-size: 28rpx;
  color: #c47a0a;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-banner-more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #d4880f;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.entry-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.entry-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}

.entry-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.entry-thumbs {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
}

.entry-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #07c160;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 10;
}


.entry-fields {
  font-size: 24rpx;
  color: #444;
  margin-bottom: 10rpx;
}

.entry-result {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.empty-visible .empty-title {
  color: #111 !important;
}

.empty-visible .empty-desc {
  color: #333 !important;
}

.empty-visible .empty-cta {
  background: #07c160 !important;
  color: #fff !important;
  border: 2rpx solid #05964a;
}

.debug-bar {
  background: #111;
  color: #fff;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  margin: -48rpx -40rpx 24rpx;
}
.secondary {
  margin-top: 16rpx;
  background: #333 !important;
}
