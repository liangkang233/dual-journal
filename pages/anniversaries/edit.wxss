.edit-page {
  padding-bottom: 80rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.row-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.label.no-margin {
  margin-bottom: 0;
}

.title-input {
  font-size: 32rpx;
  padding: 12rpx 0;
}

.date-picker {
  font-size: 30rpx;
  padding: 16rpx 0;
  color: #333;
}

.date-picker.placeholder {
  color: #bbb;
}

.hint-block {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.btn.primary {
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.submit {
  margin-top: 16rpx;
}
