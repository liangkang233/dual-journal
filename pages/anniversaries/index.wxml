<view class="page ann-page {{bgClass}}" style="{{bgStyle}}">
  <view wx:if="{{!paired}}" class="empty empty-visible">
    <image class="empty-illust" src="/assets/empty/anniversaries.jpg" mode="aspectFit" />
    <view class="empty-title">{{emptyTitle}}</view>
    <view class="empty-desc">{{emptyDesc}}</view>
    <button class="empty-cta" bindtap="goPair">去「我们」生成邀请 / 加入</button>
  </view>

  <block wx:else>
    <view class="today-banner" wx:if="{{todayList.length}}">
      <view class="today-banner-title">今日纪念</view>
      <view class="today-banner-items">
        <text wx:for="{{todayList}}" wx:key="_id" class="today-chip">{{item.title}}</text>
      </view>
    </view>

    <view wx:if="{{loading && !list.length}}" class="hint-center">加载中…</view>

    <view wx:elif="{{!list.length}}" class="empty empty-visible">
      <image class="empty-illust" src="/assets/empty/anniversaries.jpg" mode="aspectFit" />
      <view class="empty-title">还没有纪念日</view>
      <view class="empty-desc">记下相遇、在一起或任何想纪念的日子</view>
      <button class="empty-cta" bindtap="goEdit">新建纪念日</button>
    </view>

    <block wx:else>
      <!-- 视图切换按钮 -->
      <view class="view-toggle">
        <view 
          class="toggle-btn {{viewMode === 'calendar' ? 'active' : ''}}"
          bindtap="toggleViewMode"
        >
          <text class="toggle-icon">📅</text>
          <text>日历</text>
        </view>
        <view 
          class="toggle-btn {{viewMode === 'list' ? 'active' : ''}}"
          bindtap="toggleViewMode"
        >
          <text class="toggle-icon">📋</text>
          <text>列表</text>
        </view>
      </view>

      <!-- 日历视图 -->
      <view wx:if="{{viewMode === 'calendar'}}" class="calendar-view">
        <view class="calendar-header">
          <view class="month-nav" bindtap="prevMonth">‹</view>
          <view class="month-title">{{monthTitle}}</view>
          <view class="month-nav" bindtap="nextMonth">›</view>
        </view>

        <view class="calendar-weekdays">
          <view class="weekday">日</view>
          <view class="weekday">一</view>
          <view class="weekday">二</view>
          <view class="weekday">三</view>
          <view class="weekday">四</view>
          <view class="weekday">五</view>
          <view class="weekday">六</view>
        </view>

        <view class="calendar-body">
          <view 
            class="calendar-day {{item.day ? '' : 'empty'}} {{item.isToday ? 'today' : ''}} {{item.hasAnniversary ? 'has-ann' : ''}}"
            wx:for="{{calendarCells}}"
            wx:key="index"
            data-date="{{item.date}}"
            bindtap="onDayTap"
          >
            <text class="day-number">{{item.day || ''}}</text>
            <view wx:if="{{item.hasAnniversary}}" class="ann-dot"></view>
          </view>
        </view>
      </view>

      <!-- 列表视图(即将到来) -->
      <view wx:if="{{viewMode === 'list'}}" class="upcoming-list">
        <view class="list-header">即将到来</view>
        
        <view wx:if="{{!upcomingList.length}}" class="no-upcoming">
          <text>没有即将到来的纪念日</text>
        </view>
        
        <block wx:else>
          <view 
            class="upcoming-card {{item.daysUntil === 0 ? 'is-today' : ''}}"
            wx:for="{{upcomingList}}"
            wx:key="_id"
          >
            <view class="upcoming-main" data-id="{{item._id}}" bindtap="goEdit">
              <view class="upcoming-row">
                <view class="upcoming-title">{{item.title}}</view>
                <view class="upcoming-label {{item.daysUntil === 0 ? 'today-label' : ''}}">{{item.label}}</view>
              </view>
              <view class="upcoming-meta">
                <text>{{item.dateLabel}}</text>
                <text class="dot">·</text>
                <text>{{item.repeatLabel}}</text>
              </view>
            </view>
            <view
              class="upcoming-del"
              data-id="{{item._id}}"
              catchtap="onDelete"
            >删除</view>
          </view>
        </block>
      </view>
    </block>

    <view class="fab" bindtap="goEdit">+</view>
  </block>
</view>
