.ann-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  position: relative;
  min-height: 100vh;
}

.hint-center {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.today-banner {
  background: linear-gradient(135deg, #fff5e6, #ffe8f0);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #ffd4a8;
}

.today-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #d4880f;
  margin-bottom: 12rpx;
}

.today-banner-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.today-chip {
  background: #fff;
  color: #c47a0a;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 视图切换 */
.view-toggle {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.toggle-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.toggle-btn.active {
  background: linear-gradient(135deg, #ffd4a8, #ffb3c1);
  color: #fff;
  font-weight: 600;
}

.toggle-icon {
  font-size: 32rpx;
}

/* 日历视图 */
.calendar-view {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 40rpx;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.month-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #666;
  border-radius: 50%;
  background: #f5f5f5;
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0;
}

.calendar-body {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.calendar-day {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  aspect-ratio: 1 / 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 12rpx;
  background: #f8f8f8;
  border: 2rpx solid transparent;
}

.calendar-day.empty {
  background: transparent;
  /* 占位同尺寸，不画底色 */
}

.calendar-day.today {
  background: linear-gradient(135deg, #ffd4a8, #ffb3c1);
}

.calendar-day.today .day-number {
  color: #fff;
  font-weight: 600;
}

.calendar-day.has-ann {
  background: #fff5e6;
  border-color: #ffd4a8;
}

.day-number {
  font-size: 26rpx;
  color: #333;
}

.ann-dot {
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ff9800;
}

.calendar-day.today .ann-dot {
  background: #fff;
}

/* 列表视图(即将到来) */
.upcoming-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 40rpx;
}

.list-header {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
  padding: 0 8rpx;
}

.no-upcoming {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 32rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.upcoming-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.upcoming-card.is-today {
  border: 2rpx solid #ff9800;
  background: linear-gradient(135deg, #fff5e6, #ffe8f0);
}

.upcoming-main {
  flex: 1;
  min-width: 0;
}

.upcoming-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.upcoming-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upcoming-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  background: #07c160;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.upcoming-label.today-label {
  background: #ff9800;
}

.upcoming-meta {
  font-size: 24rpx;
  color: #999;
}

.upcoming-meta .dot {
  margin: 0 8rpx;
}

.upcoming-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #e64340;
  padding: 8rpx 12rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #07c160;
  color: #fff;
  font-size: 56rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 10;
}

.empty-visible .empty-title {
  color: #111 !important;
}

.empty-visible .empty-desc {
  color: #333 !important;
}

.empty-visible .empty-cta {
  background: #07c160 !important;
  color: #fff !important;
  border: 2rpx solid #05964a;
}
