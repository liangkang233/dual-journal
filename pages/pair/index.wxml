<view class="page pair-page {{bgClass}}" style="{{bgStyle}}">
  <image class="hero-cover" src="/assets/cover/launch.jpg" mode="aspectFill" />

  <view class="section card debug-panel" wx:if="{{showDebug}}">
    <view class="section-title" bindtap="onToggleDebug">真机调试 {{showDebug ? '▾' : '▸'}}</view>
    <block wx:if="{{showDebug}}">
      <view class="meta">backend：{{dataBackend}}</view>
      <view class="meta">env：{{cloudEnvId}}</view>
      <view class="meta">openid：{{openid || '（空）'}}</view>
      <view class="meta">pair：{{hasPair ? '有' : '无'}} · 成员 {{memberCount}}/2 · 码 {{inviteCode || '无'}}</view>
      <view class="meta error" wx:if="{{lastError}}">最近错误：{{lastError}}</view>
      <view class="debug-log" wx:for="{{debugLines}}" wx:key="*this">{{item}}</view>
      <button class="btn ghost" size="mini" bindtap="onProbeCloud">探测云能力</button>
      <button class="btn ghost" size="mini" bindtap="onCopyDebug">复制调试信息</button>
    </block>
  </view>
  <view class="section card">
    <view class="section-title">配对状态</view>
    <view class="status-line">{{statusText}}</view>
    <view class="meta" wx:if="{{memberCount > 0}}">成员：{{memberCount}} / 2</view>
    <view class="meta muted" wx:if="{{openid}}">我的标识：{{openid}}</view>
  </view>

  <view class="section card" wx:if="{{!paired}}">
    <view class="section-title">生成邀请码</view>
    <view class="hint">单人也可先用见闻/待办。生成邀请码后有效期 10 分钟（过期自动失效）。每 10 秒可生成一次；对方可输入码或通过分享链接加入。</view>
    <button class="btn primary invite-btn" loading="{{generating}}" disabled="{{generating || accepting || inviteCooldownSec > 0}}" bindtap="onGenerate">
      {{inviteCooldownSec > 0 ? ('请 ' + inviteCooldownSec + ' 秒后再生成') : '生成邀请码'}}
    </button>
    <view class="invite-box" wx:if="{{inviteCode}}">
      <view class="meta">邀请码</view>
      <view class="invite-code" selectable="true">{{inviteCode}}</view>
      <view class="meta">过期时间：{{expireText}}（10 分钟有效）</view>
      <button class="btn primary invite-btn" bindtap="onCopyCode">复制邀请码</button>
      <button class="btn ghost" open-type="share">分享给好友</button>
      <view class="hint">也可点右上角「…」转发小程序给对方</view>
    </view>
  </view>

  <view class="section card" wx:if="{{!paired}}">
    <view class="section-title">输入邀请码加入</view>
    <input
      class="code-input"
      maxlength="6"
      placeholder="请输入 6 位邀请码"
      value="{{inputCode}}"
      bindinput="onInputCode"
    />
    <button class="btn primary invite-btn" loading="{{accepting}}" disabled="{{accepting || generating}}" bindtap="onAccept">
      加入配对
    </button>
  </view>

  <view class="section card" wx:if="{{paired}}">
    <view class="section-title">已配对</view>
    <view class="hint">你们已结成一对。见闻、待办、纪念日将共享同步。</view>
  </view>

  <view class="section card" wx:if="{{hasPair}}">
    <view class="section-title">空间背景</view>
    <view class="hint">预设主题双方同步；也可上传一张自定义背景图。</view>
    <view class="preset-row">
      <view
        wx:for="{{presets}}"
        wx:key="id"
        class="preset-chip preset-{{item.id}} {{bgType === 'preset' && bgPresetId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectPreset"
      >{{item.label}}</view>
    </view>
    <view class="meta" wx:if="{{bgType === 'custom'}}">当前：自定义图片</view>
    <button
      class="btn ghost"
      loading="{{bgSaving}}"
      disabled="{{bgSaving}}"
      bindtap="onUploadBackground"
    >上传自定义背景</button>
  </view>

  <view class="section card" wx:if="{{hasPair}}">
    <view class="section-title">纪念日订阅提醒</view>
    <view class="hint">{{subscribeHint}}</view>
    <view class="meta" wx:if="{{subscribeAuthorized}}">状态：已授权（可再次点击刷新授权）</view>
    <view class="meta muted" wx:else>状态：未授权 · 未授权时仍可在见闻页看到「今日纪念」</view>
    <button class="btn primary" bindtap="onRequestSubscribe">
      {{subscribeAuthorized ? '重新授权订阅消息' : '开启订阅消息提醒'}}
    </button>
  </view>
</view>
