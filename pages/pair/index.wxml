<view class="page pair-page">
  <view class="section card">
    <view class="section-title">配对状态</view>
    <view class="status-line">{{statusText}}</view>
    <view class="meta" wx:if="{{memberCount > 0}}">成员：{{memberCount}} / 2</view>
    <view class="meta muted" wx:if="{{openid}}">我的标识：{{openid}}</view>
  </view>

  <view class="section card" wx:if="{{!paired}}">
    <view class="section-title">生成邀请码</view>
    <view class="hint">生成后有效期 48 小时，对方可输入码或通过分享链接加入。</view>
    <button class="btn primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onGenerate">
      生成邀请码
    </button>
    <view class="invite-box" wx:if="{{inviteCode}}">
      <view class="invite-code" bindtap="onCopyCode">{{inviteCode}}</view>
      <view class="meta">过期时间：{{expireText}}</view>
      <view class="hint">点击码可复制；右上角「…」分享给好友</view>
      <button class="btn ghost" open-type="share">分享给好友</button>
    </view>
  </view>

  <view class="section card" wx:if="{{!paired}}">
    <view class="section-title">输入邀请码加入</view>
    <input
      class="code-input"
      maxlength="6"
      placeholder="请输入 6 位邀请码"
      value="{{inputCode}}"
      bindinput="onInputCode"
    />
    <button class="btn primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onAccept">
      加入配对
    </button>
  </view>

  <view class="section card" wx:if="{{paired}}">
    <view class="section-title">已配对</view>
    <view class="hint">你们已结成一对。见闻、待办、纪念日将共享同步。背景与订阅提醒将在后续开放。</view>
  </view>
</view>
