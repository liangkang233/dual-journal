.pair-page {
  padding-bottom: 80rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

.status-line {
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}

.meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

.muted {
  color: #999;
}

.hint {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.btn {
  margin-top: 16rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
}

.btn.primary {
  background: #07c160;
  color: #fff;
}

.btn.ghost {
  background: #f0f0f0;
  color: #333;
  margin-top: 20rpx;
}

.invite-box {
  margin-top: 28rpx;
  padding: 24rpx;
  background: #f7faf8;
  border-radius: 16rpx;
  text-align: center;
}

.invite-code {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #07c160;
  margin-bottom: 12rpx;
}

.code-input {
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  text-align: center;
  background: #fafafa;
  margin-bottom: 8rpx;
}
