.pair-page {
  padding-bottom: 80rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

.status-line {
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}

.meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

.muted {
  color: #999;
}

.hint {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.btn {
  margin-top: 16rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
}

.btn.primary {
  background: #07c160;
  color: #fff;
}

.btn.ghost {
  background: #f0f0f0;
  color: #333;
  margin-top: 20rpx;
}

.invite-box {
  margin-top: 28rpx;
  padding: 24rpx;
  background: #f7faf8;
  border-radius: 16rpx;
  text-align: center;
}

.invite-code {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #07c160;
  margin-bottom: 12rpx;
}

.code-input {
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  text-align: center;
  background: #fafafa;
  margin-bottom: 8rpx;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.preset-chip {
  min-width: 120rpx;
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  text-align: center;
  border: 2rpx solid transparent;
  color: #333;
}

.preset-chip.active {
  border-color: #07c160;
  box-shadow: 0 0 0 2rpx rgba(7, 193, 96, 0.25);
  font-weight: 600;
}

.preset-warm {
  background: linear-gradient(135deg, #ffe8d0, #ffd4bc);
}

.preset-mint {
  background: linear-gradient(135deg, #d8f5eb, #c5ebe0);
}

.preset-night {
  background: linear-gradient(135deg, #1e2740, #2a3350);
  color: #e8eaf0;
}

.preset-plain {
  background: #f0f0f0;
  border-color: #ddd;
}

.invite-btn {
  background: #07c160 !important;
  color: #fff !important;
  border: 2rpx solid #05964a;
  font-weight: 600;
}

.section-title {
  color: #111 !important;
}

.status-line {
  color: #222 !important;
}

.hint {
  color: #444 !important;
}

.code-input {
  color: #111;
  background: #fff;
  border-color: #888;
}
