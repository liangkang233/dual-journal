.todos-page {
  padding-bottom: 160rpx;
  position: relative;
}

.hint-center {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.todo-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.todo-card.is-done .todo-title {
  color: #999;
  text-decoration: line-through;
}

.check {
  flex-shrink: 0;
  padding: 8rpx;
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  box-sizing: border-box;
}

.check-box.checked {
  background: #07c160;
  border-color: #07c160;
}

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.priority-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.priority-high {
  background: #e64340;
}

.priority-medium {
  background: #ff9800;
}

.priority-low {
  background: #07c160;
}

.todo-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.priority-tag {
  font-size: 22rpx;
  color: #888;
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.todo-due {
  margin-top: 8rpx;
  margin-left: 28rpx;
  font-size: 24rpx;
  color: #999;
}

.todo-del {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #e64340;
  padding: 12rpx 8rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #07c160;
  color: #fff;
  font-size: 56rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 10;
}


.todo-fields {
  margin-top: 6rpx;
  margin-left: 28rpx;
  font-size: 24rpx;
  color: #444;
}

.countdown {
  color: #c47a0a;
  font-weight: 600;
}

.empty-visible .empty-title {
  color: #111 !important;
}

.empty-visible .empty-desc {
  color: #333 !important;
}

.empty-visible .empty-cta {
  background: #07c160 !important;
  color: #fff !important;
  border: 2rpx solid #05964a;
}

.hint-center {
  color: #333;
}
