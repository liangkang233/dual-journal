.todos-page {
  padding-bottom: 160rpx;
  position: relative;
}

.hint-center {
  margin-top: 120rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.todo-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s;
}

.todo-card.is-done {
  opacity: 0.6;
}

.todo-card.is-done .todo-title {
  color: #999;
  text-decoration: line-through;
}

.todo-card.is-done .todo-fields,
.todo-card.is-done .todo-due {
  color: #bbb;
}

.check {
  flex-shrink: 0;
  padding: 4rpx;
  margin-top: 2rpx;
}

.check-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #d0d0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  box-sizing: border-box;
  transition: all 0.2s;
}

.check-box.checked {
  background: #07c160;
  border-color: #07c160;
}

.todo-main {
  flex: 1;
  min-width: 0;
}

.todo-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.todo-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.4;
  word-wrap: break-word;
}

.priority-tag {
  font-size: 20rpx;
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
  color: #fff;
}

/* 优先级芯片颜色 */
.todo-row:has(.priority-high) .priority-tag {
  background: #e64340;
}

.todo-row:has(.priority-medium) .priority-tag {
  background: #ff9800;
}

.todo-row:has(.priority-low) .priority-tag {
  background: #07c160;
}

/* 后备方案(如果不支持 :has) */
.priority-high + .todo-title + .priority-tag {
  background: #e64340;
}

.priority-medium + .todo-title + .priority-tag {
  background: #ff9800;
}

.priority-low + .todo-title + .priority-tag {
  background: #07c160;
}

.priority-dot {
  display: none;
}

.todo-fields {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.todo-due {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.countdown {
  color: #ff9800;
  font-weight: 600;
}

.todo-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #e64340;
  padding: 8rpx 12rpx;
  margin-top: 2rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #07c160;
  color: #fff;
  font-size: 56rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 10;
}

.empty-visible .empty-title {
  color: #111 !important;
}

.empty-visible .empty-desc {
  color: #333 !important;
}

.empty-visible .empty-cta {
  background: #07c160 !important;
  color: #fff !important;
  border: 2rpx solid #05964a;
}
