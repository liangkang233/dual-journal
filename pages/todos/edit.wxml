<view class="page edit-page">
  <view class="card">
    <view class="label">标题</view>
    <input
      class="title-input"
      placeholder="要做什么？"
      maxlength="60"
      value="{{title}}"
      data-field="title"
      bindinput="onFieldInput"
    />
  </view>

  <view class="card">
    <view class="label">优先级</view>
    <view class="priority-options">
      <view
        wx:for="{{priorities}}"
        wx:key="value"
        class="priority-chip priority-{{item.value}} {{priority === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onPriorityTap"
      >
        <view class="chip-dot"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{isEdit}}">
    <view class="label">状态</view>
    <view class="priority-options">
      <view
        wx:for="{{statuses}}"
        wx:key="value"
        class="priority-chip {{status === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="onStatusTap"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="label">大概时间</view>
    <input
      class="title-input"
      placeholder="如：周六上午"
      maxlength="80"
      value="{{approxTime}}"
      data-field="approxTime"
      bindinput="onFieldInput"
    />
  </view>

  <view class="card">
    <view class="label-row">
      <view class="label">截止日期（倒计时）</view>
      <view class="clear-due" wx:if="{{dueDate}}" bindtap="onClearDue">清除</view>
    </view>
    <picker mode="date" value="{{dueDate}}" bindchange="onDueChange">
      <view class="date-picker {{dueDate ? '' : 'placeholder'}}">
        {{dueDate || '选择日期'}}
      </view>
    </picker>
  </view>

  <view class="card">
    <view class="label">时间（可选）</view>
    <input
      class="title-input"
      placeholder="更精确的时间说明"
      maxlength="80"
      value="{{timeAt}}"
      data-field="timeAt"
      bindinput="onFieldInput"
    />
  </view>

  <view class="card">
    <view class="label">地点</view>
    <input
      class="title-input"
      placeholder="在哪里做"
      maxlength="80"
      value="{{location}}"
      data-field="location"
      bindinput="onFieldInput"
    />
  </view>

  <view class="card">
    <view class="label">人物</view>
    <input
      class="title-input"
      placeholder="和谁一起 / 相关人"
      maxlength="80"
      value="{{people}}"
      data-field="people"
      bindinput="onFieldInput"
    />
  </view>

  <view class="card">
    <view class="label">起因</view>
    <textarea
      class="content-input"
      placeholder="为什么要做"
      maxlength="500"
      value="{{cause}}"
      data-field="cause"
      bindinput="onFieldInput"
      auto-height
    />
  </view>

  <view class="card">
    <view class="label">经过</view>
    <textarea
      class="content-input"
      placeholder="计划怎么做 / 进展"
      maxlength="1000"
      value="{{process}}"
      data-field="process"
      bindinput="onFieldInput"
      auto-height
    />
  </view>

  <view class="card">
    <view class="label">结果</view>
    <textarea
      class="content-input"
      placeholder="期望结果或完成情况"
      maxlength="500"
      value="{{result}}"
      data-field="result"
      bindinput="onFieldInput"
      auto-height
    />
  </view>

  <button
    class="btn primary submit"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="onSubmit"
  >
    {{isEdit ? '保存修改' : '创建待办'}}
  </button>
</view>
